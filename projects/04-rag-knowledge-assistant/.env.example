OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma
# Local development chat requests can take several minutes on CPU.
OLLAMA_CHAT_TIMEOUT_MS=240000
OLLAMA_EMBED_TIMEOUT_MS=120000
# Unload embedding model to make room for chat model on lower-memory systems.
OLLAMA_EMBED_KEEP_ALIVE=0
