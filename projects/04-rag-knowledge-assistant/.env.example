OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma
# Local development chat requests can take several minutes on CPU.
OLLAMA_CHAT_TIMEOUT_MS=240000
OLLAMA_EMBED_TIMEOUT_MS=120000
# Unload embedding model to make room for chat model on lower-memory systems.
OLLAMA_EMBED_KEEP_ALIVE=0

# Storage backends: file (default) or postgres.
RAG_STORAGE=file
# Uncomment when using RAG_STORAGE=postgres. Never commit real credentials.
# DATABASE_URL=postgresql://rag_user:CHANGE_ME@localhost:5432/rag_lab

# Optional chat limits for low-memory CPU-only laptops; defaults 256 and 3072.
# Smaller outputs and context can reduce latency but may cut off useful answers.
# OLLAMA_CHAT_NUM_PREDICT=128
# OLLAMA_CHAT_NUM_CTX=2048
